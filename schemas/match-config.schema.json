{
  "$id": "https://open-empires-lab/match-config.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MatchConfig",
  "allOf": [{ "if": { "properties": { "version": { "const": 1 } } },
    "then": { "not": { "anyOf": [{ "required": ["mode"] }, { "required": ["populationLimit"] }, { "required": ["wonderVictory"] }] } } }],
  "type": "object",
  "properties": {
    "wonderVictory": { "type": "boolean" },
    "populationLimit": { "enum": [25, 50, 75, 100, 125, 150, 175, 200, 225, 250, 300, 400, 500] },
    "mode": { "enum": ["random-map", "regicide"] },
    "version": {
      "enum": [1, 2, 3, 4, 5, 6]
    },
    "seed": {
      "type": "integer",
      "minimum": 1
    },
    "maxTimeSeconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "decideIntervalSeconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "civilizations": {
      "type": "object",
      "properties": {
        "1": {
          "type": "string"
        },
        "2": {
          "type": "string"
        }
      },
      "required": [
        "1",
        "2"
      ],
      "additionalProperties": false
    },
    "map": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "version",
    "seed"
  ],
  "additionalProperties": false
}
