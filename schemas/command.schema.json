{
  "$id": "https://open-empires-lab/command.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Command",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "order"
        },
        "player": {
          "enum": [
            1,
            2
          ]
        },
        "entityIds": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 1
        },
        "target": {
          "$ref": "#/definitions/point"
        },
        "targetId": {
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "player",
        "entityIds",
        "target"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "train"
        },
        "player": {
          "enum": [
            1,
            2
          ]
        },
        "buildingId": {
          "type": "integer"
        },
        "unit": {
          "enum": [
            "villager",
            "militia",
            "man-at-arms",
            "long-swordsman",
            "two-handed-swordsman",
            "champion",
            "spearman",
            "pikeman",
            "halberdier",
            "archer",
            "crossbowman",
            "arbalester",
            "skirmisher",
            "elite-skirmisher",
            "scout-cavalry",
            "light-cavalry",
            "trade-cart",
            "knight",
            "cavalier",
            "cavalry-archer",
            "heavy-cavalry-archer",
            "longbowman",
            "elite-longbowman",
            "battering-ram",
            "capped-ram",
            "mangonel",
            "onager",
            "trebuchet",
            "monk"
          ]
        }
      },
      "required": [
        "kind",
        "player",
        "buildingId",
        "unit"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "research"
        },
        "player": {
          "enum": [
            1,
            2
          ]
        },
        "buildingId": {
          "type": "integer"
        },
        "tech": {
          "type": "string",
          "minLength": 1,
          "$comment": "Which technologies exist depends on the imported content and the civilisation; the Britons tree carries 42."
        }
      },
      "required": [
        "kind",
        "player",
        "buildingId",
        "tech"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "build"
        },
        "player": {
          "enum": [
            1,
            2
          ]
        },
        "builderIds": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 1
        },
        "building": {
          "enum": [
            "barracks",
            "house",
            "mill",
            "lumber-camp",
            "mining-camp",
            "farm",
            "outpost",
            "watch-tower",
            "archery-range",
            "blacksmith",
            "market",
            "stable",
            "monastery",
            "siege-workshop",
            "castle",
            "university",
            "wonder",
            "palisade-wall",
            "palisade-gate"
          ]
        },
        "target": {
          "$ref": "#/definitions/point"
        },
        "orientation": {
          "enum": [
            "x",
            "y"
          ]
        }
      },
      "required": [
        "kind",
        "player",
        "builderIds",
        "building",
        "target"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "rally"
        },
        "player": {
          "enum": [
            1,
            2
          ]
        },
        "buildingId": {
          "type": "integer"
        },
        "target": {
          "$ref": "#/definitions/point"
        },
        "targetId": {
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "player",
        "buildingId",
        "target"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "stop"
        },
        "player": {
          "enum": [
            1,
            2
          ]
        },
        "entityIds": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 1
        }
      },
      "required": [
        "kind",
        "player",
        "entityIds"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "reseed"
        },
        "player": {
          "enum": [
            1,
            2
          ]
        },
        "buildingId": {
          "type": "integer",
          "$comment": "One of the player's finished mills: where the option is offered."
        },
        "enabled": {
          "type": "boolean",
          "$comment": "Whether a villager whose farm goes fallow sows it again on the spot, paying the farm's wood. Off until asked for."
        }
      },
      "required": [
        "kind",
        "player",
        "buildingId",
        "enabled"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "pack"
        },
        "player": {
          "enum": [
            1,
            2
          ]
        },
        "entityIds": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 1
        },
        "unpacked": {
          "type": "boolean",
          "$comment": "True sets a siege engine up to shoot, false packs it away to travel. The DAT keeps the two states as separate units (a trebuchet is 331 packed and 42 unpacked)."
        }
      },
      "required": [
        "kind",
        "player",
        "entityIds",
        "unpacked"
      ],
      "additionalProperties": false
    }
  ],
  "definitions": {
    "point": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    }
  }
}
