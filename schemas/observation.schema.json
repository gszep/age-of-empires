{
  "$id": "https://open-empires-lab/observation.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlayerObservation",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "time": {
      "type": "number",
      "minimum": 0
    },
    "player": {
      "enum": [
        1,
        2
      ]
    },
    "winner": {
      "enum": [
        1,
        2
      ]
    },
    "mapWidth": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "mapHeight": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "food": {
      "type": "integer",
      "minimum": 0
    },
    "wood": {
      "type": "integer",
      "minimum": 0
    },
    "gold": {
      "type": "integer",
      "minimum": 0
    },
    "stone": {
      "type": "integer",
      "minimum": 0
    },
    "population": {
      "type": "integer",
      "minimum": 0
    },
    "populationCap": {
      "type": "integer",
      "minimum": 0
    },
    "age": {
      "type": "integer",
      "minimum": 0
    },
    "researched": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "memory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "kind": {
            "enum": [
              "villager",
              "militia",
              "man-at-arms",
              "long-swordsman",
              "two-handed-swordsman",
              "champion",
              "spearman",
              "pikeman",
              "halberdier",
              "archer",
              "crossbowman",
              "arbalester",
              "skirmisher",
              "elite-skirmisher",
              "scout-cavalry",
              "light-cavalry",
              "trade-cart",
              "fishing-ship",
              "knight",
              "cavalier",
              "cavalry-archer",
              "heavy-cavalry-archer",
              "longbowman",
              "elite-longbowman",
              "battering-ram",
              "capped-ram",
              "mangonel",
              "onager",
              "trebuchet",
              "monk",
              "sheep",
              "deer",
              "boar",
              "town-center",
              "barracks",
              "house",
              "mill",
              "lumber-camp",
              "mining-camp",
              "farm",
              "outpost",
              "watch-tower",
              "archery-range",
              "blacksmith",
              "market",
              "stable",
              "dock",
              "monastery",
              "siege-workshop",
              "castle",
              "university",
              "wonder",
              "palisade-wall",
              "palisade-gate",
              "resource"
            ]
          },
          "owner": {
            "enum": [
              0,
              1,
              2
            ]
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "hp": {
            "type": "number"
          },
          "maxHp": {
            "type": "number"
          },
          "resource": {
            "enum": [
              "food",
              "wood",
              "gold",
              "stone"
            ]
          },
          "node": {
            "$comment": "Which node a resource is: a shore fish and a bush are both food, but only a boat reaches the open sea.",
            "enum": [
              "berries",
              "tree",
              "gold",
              "stone",
              "shore-fish",
              "fish"
            ]
          },
          "amount": {
            "type": "integer",
            "minimum": 0
          },
          "buildProgress": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "lastSeenAt": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "kind",
          "owner",
          "x",
          "y",
          "hp",
          "maxHp",
          "lastSeenAt"
        ],
        "additionalProperties": false
      }
    },
    "explored": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[01]+$"
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "kind": {
            "enum": [
              "villager",
              "militia",
              "man-at-arms",
              "long-swordsman",
              "two-handed-swordsman",
              "champion",
              "spearman",
              "pikeman",
              "halberdier",
              "archer",
              "crossbowman",
              "arbalester",
              "skirmisher",
              "elite-skirmisher",
              "scout-cavalry",
              "light-cavalry",
              "trade-cart",
              "fishing-ship",
              "knight",
              "cavalier",
              "cavalry-archer",
              "heavy-cavalry-archer",
              "longbowman",
              "elite-longbowman",
              "battering-ram",
              "capped-ram",
              "mangonel",
              "onager",
              "trebuchet",
              "monk",
              "sheep",
              "deer",
              "boar",
              "town-center",
              "barracks",
              "house",
              "mill",
              "lumber-camp",
              "mining-camp",
              "farm",
              "outpost",
              "watch-tower",
              "archery-range",
              "blacksmith",
              "market",
              "stable",
              "dock",
              "monastery",
              "siege-workshop",
              "castle",
              "university",
              "wonder",
              "palisade-wall",
              "palisade-gate",
              "resource"
            ]
          },
          "owner": {
            "enum": [
              0,
              1,
              2
            ]
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "hp": {
            "type": "number"
          },
          "maxHp": {
            "type": "number"
          },
          "resource": {
            "enum": [
              "food",
              "wood",
              "gold",
              "stone"
            ]
          },
          "node": {
            "$comment": "Which node a resource is: a shore fish and a bush are both food, but only a boat reaches the open sea.",
            "enum": [
              "berries",
              "tree",
              "gold",
              "stone",
              "shore-fish",
              "fish"
            ]
          },
          "amount": {
            "type": "integer",
            "minimum": 0
          },
          "buildProgress": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "activity": {
            "enum": [
              "idle",
              "moving",
              "gathering",
              "carrying",
              "building",
              "attacking",
              "dying",
              "healing",
              "converting",
              "repairing"
            ]
          },
          "order": {
            "enum": [
              "idle",
              "move",
              "gather",
              "build",
              "attack",
              "trade",
              "heal",
              "convert",
              "repair",
              "garrison"
            ]
          },
          "garrisoned": {
            "type": "integer",
            "minimum": 0,
            "$comment": "Units sheltering inside this building of yours; they are not in the entity list while they are."
          },
          "carrying": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "food",
                  "wood",
                  "gold",
                  "stone"
                ]
              },
              "amount": {
                "type": "integer",
                "minimum": 0
              },
              "node": {
                "enum": [
                  "berries",
                  "tree",
                  "gold",
                  "stone",
                  "shore-fish",
                  "fish"
                ]
              }
            },
            "required": [
              "kind",
              "amount"
            ],
            "additionalProperties": false
          },
          "training": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "villager",
                  "militia",
                  "man-at-arms",
                  "long-swordsman",
                  "two-handed-swordsman",
                  "champion",
                  "spearman",
                  "pikeman",
                  "halberdier",
                  "archer",
                  "crossbowman",
                  "arbalester",
                  "skirmisher",
                  "elite-skirmisher",
                  "scout-cavalry",
                  "light-cavalry",
                  "trade-cart",
                  "fishing-ship",
                  "knight",
                  "cavalier",
                  "cavalry-archer",
                  "heavy-cavalry-archer",
                  "longbowman",
                  "elite-longbowman",
                  "battering-ram",
                  "capped-ram",
                  "mangonel",
                  "onager",
                  "trebuchet",
                  "monk"
                ]
              },
              "remainingSeconds": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "kind",
              "remainingSeconds"
            ],
            "additionalProperties": false
          },
          "researching": {
            "type": "object",
            "properties": {
              "tech": {
                "type": "string"
              },
              "remainingSeconds": {
                "type": "number"
              }
            },
            "required": [
              "tech",
              "remainingSeconds"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "kind",
          "owner",
          "x",
          "y",
          "hp",
          "maxHp"
        ],
        "additionalProperties": false
      }
    },
    "civilization": {
      "type": "string"
    },
    "autoReseedFarms": {
      "type": "boolean"
    }
  },
  "required": [
    "version",
    "time",
    "player",
    "mapWidth",
    "mapHeight",
    "food",
    "wood",
    "gold",
    "stone",
    "population",
    "populationCap",
    "age",
    "researched",
    "entities",
    "memory",
    "explored",
    "civilization"
  ],
  "additionalProperties": false
}
