{
  "$id": "https://open-empires-lab/observation.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlayerObservation",
  "type": "object",
  "properties": {
    "version": {
      "const": 5
    },
    "time": {
      "type": "number",
      "minimum": 0
    },
    "player": {
      "enum": [
        1,
        2
      ]
    },
    "winner": {
      "enum": [
        1,
        2
      ]
    },
    "mapWidth": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "mapHeight": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "food": {
      "type": "integer",
      "minimum": 0
    },
    "wood": {
      "type": "integer",
      "minimum": 0
    },
    "gold": {
      "type": "integer",
      "minimum": 0
    },
    "stone": {
      "type": "integer",
      "minimum": 0
    },
    "population": {
      "type": "integer",
      "minimum": 0
    },
    "populationCap": {
      "type": "integer",
      "minimum": 0
    },
    "age": {
      "type": "integer",
      "minimum": 0
    },
    "researched": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "memory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "kind": {
            "anyOf": [{ "type": "string", "pattern": "^dat-unit-[0-9]+$" }, {
            "enum": [
              "villager",
              "militia",
              "man-at-arms",
              "long-swordsman",
              "two-handed-swordsman",
              "champion",
              "spearman",
              "pikeman",
              "halberdier",
              "archer",
              "crossbowman",
              "arbalester",
              "skirmisher",
              "elite-skirmisher",
              "scout-cavalry",
              "light-cavalry",
              "trade-cart",
              "fishing-ship",
              "galley", "war-galley", "galleon", "hulk", "war-hulk",
              "fire-galley", "fire-ship", "fast-fire-ship", "demolition-raft",
              "demolition-ship", "heavy-demolition-ship", "cannon-galleon", "transport-ship", "trade-cog",
              "knight",
              "cavalier",
              "cavalry-archer",
              "heavy-cavalry-archer",
              "longbowman",
              "elite-longbowman",
              "battering-ram",
              "capped-ram",
              "mangonel",
              "onager",
              "scorpion",
              "heavy-scorpion",
              "petard", "siege-tower",
              "trebuchet",
              "monk",
              "sheep",
              "deer",
              "boar",
              "town-center",
              "barracks",
              "house",
              "mill",
              "lumber-camp",
              "mining-camp",
              "farm",
              "outpost",
              "watch-tower",
              "archery-range",
              "blacksmith",
              "market",
              "stable",
              "dock",
              "monastery",
              "siege-workshop",
              "castle",
              "university",
              "wonder",
              "palisade-wall",
              "palisade-gate",
              "stone-wall", "fortified-wall", "stone-gate", "fortified-gate", "guard-tower", "keep",
              "fish-trap",
              "resource", "relic"
            ]
            }]
          },
          "owner": {
            "enum": [
              0,
              1,
              2
            ]
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "hp": {
            "type": "number"
          },
          "maxHp": {
            "type": "number"
          },
          "resource": {
            "enum": [
              "food",
              "wood",
              "gold",
              "stone"
            ]
          },
          "node": {
            "$comment": "Which node a resource is: a shore fish and a bush are both food, but only a boat reaches the open sea.",
            "enum": [
              "berries",
              "tree",
              "gold",
              "stone",
              "shore-fish",
              "fish"
            ]
          },
          "amount": {
            "type": "integer",
            "minimum": 0
          },
          "buildProgress": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "hasGarrison": { "type": "boolean" },
          "lastSeenAt": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "kind",
          "owner",
          "x",
          "y",
          "hp",
          "maxHp",
          "lastSeenAt"
        ],
        "additionalProperties": false
      }
    },
    "explored": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[01]+$"
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "buildTargetId": {
            "description": "Own builder's assigned foundation, including while approaching it.",
            "type": "integer"
          },
          "gatherTargetId": {
            "description": "Own gatherer's resource target, including travel and drop-off.",
            "type": "integer"
          },
          "hasGarrison": { "type": "boolean" },
          "townBell": { "type": "boolean" },
          "kind": {
            "anyOf": [{ "type": "string", "pattern": "^dat-unit-[0-9]+$" }, {
            "enum": [
              "villager",
              "militia",
              "man-at-arms",
              "long-swordsman",
              "two-handed-swordsman",
              "champion",
              "spearman",
              "pikeman",
              "halberdier",
              "archer",
              "crossbowman",
              "arbalester",
              "skirmisher",
              "elite-skirmisher",
              "scout-cavalry",
              "light-cavalry",
              "trade-cart",
              "fishing-ship",
              "galley", "war-galley", "galleon", "hulk", "war-hulk",
              "fire-galley", "fire-ship", "fast-fire-ship", "demolition-raft",
              "demolition-ship", "heavy-demolition-ship", "cannon-galleon", "transport-ship", "trade-cog",
              "knight",
              "cavalier",
              "cavalry-archer",
              "heavy-cavalry-archer",
              "longbowman",
              "elite-longbowman",
              "battering-ram",
              "capped-ram",
              "mangonel",
              "onager",
              "scorpion",
              "heavy-scorpion",
              "petard", "siege-tower",
              "trebuchet",
              "monk",
              "sheep",
              "deer",
              "boar",
              "town-center",
              "barracks",
              "house",
              "mill",
              "lumber-camp",
              "mining-camp",
              "farm",
              "outpost",
              "watch-tower",
              "archery-range",
              "blacksmith",
              "market",
              "stable",
              "dock",
              "monastery",
              "siege-workshop",
              "castle",
              "university",
              "wonder",
              "palisade-wall",
              "palisade-gate",
              "stone-wall", "fortified-wall", "stone-gate", "fortified-gate", "guard-tower", "keep",
              "fish-trap",
              "resource", "relic"
            ]
            }]
          },
          "owner": {
            "enum": [
              0,
              1,
              2
            ]
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "hp": {
            "type": "number"
          },
          "maxHp": {
            "type": "number"
          },
          "resource": {
            "enum": [
              "food",
              "wood",
              "gold",
              "stone"
            ]
          },
          "node": {
            "$comment": "Which node a resource is: a shore fish and a bush are both food, but only a boat reaches the open sea.",
            "enum": [
              "berries",
              "tree",
              "gold",
              "stone",
              "shore-fish",
              "fish"
            ]
          },
          "amount": {
            "type": "integer",
            "minimum": 0
          },
          "buildProgress": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "activity": {
            "enum": [
              "idle",
              "moving",
              "gathering",
              "carrying",
              "building",
              "attacking",
              "dying",
              "healing",
              "converting",
              "repairing"
            ]
          },
          "order": {
            "enum": [
              "idle",
              "move",
              "gather",
              "build",
              "attack",
              "trade",
              "heal",
              "convert",
              "repair",
              "garrison", "unload", "cross-wall", "relic"
            ]
          },
          "garrisoned": {
            "type": "integer",
            "minimum": 0,
            "$comment": "Units sheltering inside this building of yours; they are not in the entity list while they are."
          },
          "carryingRelic": { "type": "boolean" },
          "relics": { "type": "integer", "minimum": 0 },
          "faith": { "type": "number", "minimum": 0, "maximum": 100 },
          "carrying": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "food",
                  "wood",
                  "gold",
                  "stone"
                ]
              },
              "amount": {
                "type": "integer",
                "minimum": 0
              },
              "node": {
                "enum": [
                  "berries",
                  "tree",
                  "gold",
                  "stone",
                  "shore-fish",
                  "fish"
                ]
              }
            },
            "required": [
              "kind",
              "amount"
            ],
            "additionalProperties": false
          },
          "training": {
            "type": "object",
            "properties": {
              "kind": {
                "anyOf": [{ "type": "string", "pattern": "^dat-unit-[0-9]+$" }, {
                "enum": [
                  "villager",
                  "militia",
                  "man-at-arms",
                  "long-swordsman",
                  "two-handed-swordsman",
                  "champion",
                  "spearman",
                  "pikeman",
                  "halberdier",
                  "archer",
                  "crossbowman",
                  "arbalester",
                  "skirmisher",
                  "elite-skirmisher",
                  "scout-cavalry",
                  "light-cavalry",
                  "trade-cart",
                  "fishing-ship",
                  "galley", "war-galley", "galleon", "hulk", "war-hulk",
                  "fire-galley", "fire-ship", "fast-fire-ship", "demolition-raft",
                  "demolition-ship", "heavy-demolition-ship", "cannon-galleon", "transport-ship", "trade-cog",
                  "knight",
                  "cavalier",
                  "cavalry-archer",
                  "heavy-cavalry-archer",
                  "longbowman",
                  "elite-longbowman",
                  "battering-ram",
                  "capped-ram",
                  "mangonel",
                  "onager",
                  "scorpion",
                  "heavy-scorpion",
                  "petard", "siege-tower",
                  "trebuchet",
                  "monk"
                ]
                }]
              },
              "remainingSeconds": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "kind",
              "remainingSeconds"
            ],
            "additionalProperties": false
          },
          "researching": {
            "type": "object",
            "properties": {
              "tech": {
                "type": "string"
              },
              "remainingSeconds": {
                "type": "number"
              }
            },
            "required": [
              "tech",
              "remainingSeconds"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "kind",
          "owner",
          "x",
          "y",
          "hp",
          "maxHp"
        ],
        "additionalProperties": false
      }
    },
    "civilization": {
      "type": "string"
    },
    "autoReseedFarms": {
      "type": "boolean"
    }
  },
  "required": [
    "version",
    "time",
    "player",
    "mapWidth",
    "mapHeight",
    "food",
    "wood",
    "gold",
    "stone",
    "population",
    "populationCap",
    "age",
    "researched",
    "entities",
    "memory",
    "explored",
    "civilization"
  ],
  "additionalProperties": false
}
