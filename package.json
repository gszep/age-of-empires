{
  "name": "open-empires-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "match": "tsx src/headless/cli.ts",
    "batch": "tsx src/headless/batch.ts",
    "test:live-agent": "RUN_LIVE_AGENT=1 tsx src/headless/live-agent.ts",
    "tools:setup": "tools/bootstrap.sh",
    "import:aoe2": "tools/import_aoe2.sh",
    "test:import": ".tools/import-venv/bin/python -m unittest discover -s tools -p 'test_*.py' -v"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "three": "^0.180.0",
    "ws": "^8.21.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.1",
    "ajv": "^8.20.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
